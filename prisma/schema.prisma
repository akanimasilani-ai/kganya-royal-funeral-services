// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// AUTHENTICATION & USER MANAGEMENT
// ============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String    // hashed with bcryptjs
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(CUSTOMER)
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  customer      Customer?
  adminUser     AdminUser?
  sessions      Session[]
  notifications Notification[]
  auditLogs     AuditLog[]

  @@index([email])
  @@index([role])
  @@index([status])
}

enum UserRole {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

model Session {
  id        String   @id @default(cuid())
  sessionToken String  @unique
  userId    String
  expires   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================================
// CUSTOMER MANAGEMENT
// ============================================================================

model Customer {
  id                String    @id @default(cuid())
  userId            String    @unique
  firstName         String
  surname           String
  idNumber          String    @unique
  dateOfBirth       DateTime
  gender            Gender?
  phone             String
  email             String
  address           String
  city              String
  province          String
  postalCode        String
  country           String    @default("South Africa")
  status            CustomerStatus @default(ACTIVE)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications      Application[]
  dependants        Dependant[]
  quoteRequests     QuoteRequest[]
  cateringRequests  CateringRequest[]
  payments          Payment[]
  documents         Document[]

  @@index([userId])
  @@index([email])
  @@index([idNumber])
  @@index([status])
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  CANCELLED
}

model Dependant {
  id            String   @id @default(cuid())
  customerId    String
  fullName      String
  relationship  String
  dateOfBirth   DateTime
  idNumber      String?
  status        DependantStatus @default(ACTIVE)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

enum DependantStatus {
  ACTIVE
  INACTIVE
}

// ============================================================================
// APPLICATIONS
// ============================================================================

model Application {
  id                    String    @id @default(cuid())
  customerId            String
  referenceNumber       String    @unique
  packageId             String
  status                ApplicationStatus @default(DRAFT)
  submittedAt           DateTime?
  reviewedAt            DateTime?
  approvedAt            DateTime?
  declinedReason        String?
  internalNotes         String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  customer              Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  package               Package   @relation(fields: [packageId], references: [id])
  beneficiaries         Beneficiary[]
  documents             Document[]
  statusHistory         ApplicationStatusHistory[]
  payments              Payment[]

  @@index([customerId])
  @@index([packageId])
  @@index([status])
  @@index([referenceNumber])
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  AWAITING_INFORMATION
  APPROVED
  DECLINED
  CANCELLED
}

model ApplicationStatusHistory {
  id            String   @id @default(cuid())
  applicationId String
  previousStatus ApplicationStatus
  newStatus      ApplicationStatus
  changedBy      String   // Admin user ID
  notes          String?
  createdAt      DateTime @default(now())

  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model Beneficiary {
  id            String   @id @default(cuid())
  applicationId String
  fullName      String
  relationship  String
  dateOfBirth   DateTime
  idNumber      String?
  createdAt     DateTime @default(now())

  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

// ============================================================================
// PACKAGES & SERVICES
// ============================================================================

model Package {
  id            String   @id @default(cuid())
  name          String   @unique
  description   String
  type          PackageType
  coverAmount   Decimal  @db.Decimal(12, 2)
  monthlyPremium Decimal @db.Decimal(12, 2)
  benefits      String   // JSON array of benefits
  features      String   // JSON array of features
  status        PackageStatus @default(ACTIVE)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  applications  Application[]

  @@index([type])
  @@index([status])
}

enum PackageType {
  FUNERAL_COVER_SILVER
  FUNERAL_COVER_GOLD
  FUNERAL_COVER_PLATINUM
  FUNERAL_SERVICES_BASIC
  FUNERAL_SERVICES_PREMIUM
}

enum PackageStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Service {
  id            String   @id @default(cuid())
  name          String   @unique
  description   String
  category      ServiceCategory
  imageUrl      String?
  includes      String   // JSON array
  status        ServiceStatus @default(ACTIVE)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([status])
}

enum ServiceCategory {
  FUNERAL_ARRANGEMENTS
  BURIAL_SERVICES
  CREMATION_ASSISTANCE
  FUNERAL_TRANSPORT
  MORTUARY_COORDINATION
  MEMORIAL_SERVICES
  TOMBSTONE_ASSISTANCE
  FAMILY_SUPPORT
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

// ============================================================================
// REQUESTS & ENQUIRIES
// ============================================================================

model QuoteRequest {
  id              String   @id @default(cuid())
  customerId      String
  referenceNumber String   @unique
  fullName        String
  phone           String
  email           String
  serviceRequired String
  preferredPackage String?
  estimatedGuests Int?
  preferredDate   DateTime?
  message         String?
  status          QuoteStatus @default(NEW)
  response        String?
  respondedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([status])
  @@index([referenceNumber])
}

enum QuoteStatus {
  NEW
  CONTACTED
  QUOTED
  ACCEPTED
  REJECTED
  CANCELLED
}

model CateringRequest {
  id              String   @id @default(cuid())
  customerId      String
  referenceNumber String   @unique
  fullName        String
  phone           String
  email           String
  category        CateringCategory
  numberOfGuests  Int
  preferredDate   DateTime?
  specialRequests String?
  status          CateringStatus @default(NEW)
  response        String?
  respondedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([status])
  @@index([referenceNumber])
}

enum CateringCategory {
  FUNERAL_CATERING
  FAMILY_CATERING
  EVENT_CATERING
  REFRESHMENTS
  CUSTOM
}

enum CateringStatus {
  NEW
  CONTACTED
  QUOTED
  ACCEPTED
  REJECTED
  CANCELLED
}

// ============================================================================
// PAYMENTS
// ============================================================================

model Payment {
  id              String   @id @default(cuid())
  customerId      String
  referenceNumber String   @unique
  applicationId   String?
  amount          Decimal  @db.Decimal(12, 2)
  currency        String   @default("ZAR")
  description     String
  status          PaymentStatus @default(PENDING)
  paymentMethod   PaymentMethod?
  transactionId   String?  // Payment provider transaction ID
  failureReason   String?
  processedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  customerData Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([status])
  @@index([referenceNumber])
  @@index([transactionId])
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  EFT
  BANK_TRANSFER
  PAYPAL
  OTHER
}

// ============================================================================
// DOCUMENTS
// ============================================================================

model Document {
  id            String   @id @default(cuid())
  customerId    String
  applicationId String?
  fileName      String
  fileType      String
  fileSize      Int
  storagePath   String   // Path to stored file
  documentType  DocumentType
  uploadedBy    String   // User ID
  status        DocumentStatus @default(PENDING_REVIEW)
  verifiedAt    DateTime?
  verifiedBy    String?  // Admin user ID
  rejectionReason String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([applicationId])
  @@index([documentType])
  @@index([status])
}

enum DocumentType {
  ID_COPY
  PROOF_OF_ADDRESS
  MARRIAGE_CERTIFICATE
  DEATH_CERTIFICATE
  BIRTH_CERTIFICATE
  BANK_STATEMENT
  PAYSLIP
  OTHER
}

enum DocumentStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

// ============================================================================
// NOTIFICATIONS
// ============================================================================

model Notification {
  id            String   @id @default(cuid())
  userId        String
  type          NotificationType
  title         String
  message       String
  relatedEntityType String?
  relatedEntityId String?
  read          Boolean  @default(false)
  readAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([type])
}

enum NotificationType {
  REGISTRATION_CONFIRMATION
  APPLICATION_SUBMITTED
  APPLICATION_STATUS_CHANGED
  QUOTE_RECEIVED
  PAYMENT_RECEIVED
  DOCUMENT_REQUIRED
  SYSTEM_UPDATE
  ADMIN_MESSAGE
}

// ============================================================================
// ADMIN USERS
// ============================================================================

model AdminUser {
  id              String   @id @default(cuid())
  userId          String   @unique
  department      String?
  permissions     String   // JSON array of permissions
  lastLoginAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================================
// AUDIT LOGS
// ============================================================================

model AuditLog {
  id            String   @id @default(cuid())
  userId        String
  action        String
  entityType    String
  entityId      String
  changes       String   // JSON object of changes
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entityType])
  @@index([createdAt])
}
